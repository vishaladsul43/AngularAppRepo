pipeline {
 agent any
 tools {
    nodejs "NodeJS"
 }
 stages {
    stage("Checkout") {
steps {
    checkout scm
}
    }
    stage("install Package") {
        steps {
         bat "npm ci"
        }
    }
    stage("Testing"){
        steps{
// bat "npx ng test --no-watch --no-progress --browser=ChromeHeadless"
echo "testing"
        }
    }
    stage("build"){
        steps{
            bat "npx ng build --configuration production"
        }
    }
    stage("deployment"){
        steps{
            bat "del /q /s c:\\inetpub\\wwwroot\\Angular\\*"
            bat "xcopy /E /Y /I dist\\NodeDemo\\browser\\* c:\\inetpub\\wwwroot\\Angular\\*"
        }
    }
 }
 post {
    success {
        echo "angular application biuld successfully"
    }
    failure{
        echo "angular app build failed"
    }
 }
}